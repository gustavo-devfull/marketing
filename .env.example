# Copie para .env.local e preencha (Supabase > Project Settings > API).
# Use o MESMO projeto Supabase do sistema Base de Produtos: a lista de produtos vem da tabela `products`.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Link do sistema Base de Produtos (opcional, aparece no cabeçalho)
VITE_PRODUCTS_SYSTEM_URL=
